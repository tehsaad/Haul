{
  "manifest_version": 3,
  "name": "Haul",
  "version": "0.4.0",
  "description": "Finds audio and video on pages and sends downloads to the Haul download manager.",
  "key": "",
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "detector.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Haul",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "haul@tehsaad.github.io",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
